# Supabase Configuration
# Fill in your project URL and public anon/service key from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Database Connection URL (Optional - defaults to local SQLite if not provided)
# For Supabase PostgreSQL direct connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./kisaan_setu.db
